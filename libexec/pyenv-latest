#!/usr/bin/env bash
# Summary: Print the latest installed or known version with the given prefix
# Usage: pyenv latest [-k|--known] [--prerelease] <prefix>
#
#   -k/--known      Select from all known versions instead of installed
#   --prerelease    Include prerelease versions (alpha, beta, rc)
#   -b/--bypass     (internal) On a resolution failure, do not print an error message
#                   but rather print the argument unchanged
#   -f/--force      (internal) Same as -b but also do not return a failure exit code

set -euo pipefail
set -f
[ -n "${PYENV_DEBUG:-}" ] && set -x

# Provide pyenv completions
if [ "${1:-}" = "--complete" ]; then
  echo --known
  echo --prerelease
  exit
fi

FROM_KNOWN=
PRERELEASE=
BYPASS=
FORCE=

while [[ $# -gt 0 ]]
do
    case "$1" in
        -k|--known)
            FROM_KNOWN=1
            shift
            ;;
        --prerelease)
            PRERELEASE=1
            shift
            ;;
        -b|--bypass)
            BYPASS=1
            shift
            ;;
        -f|--force)
            FORCE=1
            BYPASS=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

prefix="${1:-}"
exitcode=0

IFS=$'\n'

    if [[ -z "$FROM_KNOWN" ]]; then
        if [[ -d $PYENV_ROOT/versions/$prefix ]]; then
            echo "$prefix"
            exit $exitcode;
        fi
        DEFINITION_CANDIDATES=( $(pyenv-versions --bare --skip-envs) )
    else
        DEFINITION_CANDIDATES=( $(pyenv-install --list --bare) )
    fi

    # Avoid `grep -q' to prevent SIGPIPE that would fail the check with pipefail
    # Bash < 4.4 treats empty arrays as unset with -u;
    # "${v[@]:-}" produces "" for an empty array which is okay
    # for `printf '%s\n'` as it prints an empty line for zero args anyway
    if printf '%s\n' "${DEFINITION_CANDIDATES[@]:-}" | grep -xFe "$prefix" >/dev/null; then
        echo "$prefix"
        exit $exitcode;
    fi

    suffix=
    if [[ $prefix =~ ^(.*[0-9])t$ ]]; then
        suffix="t"
        prefix="${BASH_REMATCH[1]}"
    fi

    # https://stackoverflow.com/questions/11856054/is-there-an-easy-way-to-pass-a-raw-string-to-grep/63483807#63483807
    prefix_re="$(sed 's/[^\^]/[&]/g;s/[\^]/\\&/g' <<< "$prefix")"
    suffix_re="$(sed 's/[^\^]/[&]/g;s/[\^]/\\&/g' <<< "$suffix")"
    # FIXME: more reliable and readable would probably be to loop over them and transform in pure Bash
    DEFINITION_CANDIDATES=(\
      $(printf '%s\n' "${DEFINITION_CANDIDATES[@]:-}" | \
      grep -Ee "^$prefix_re[-.].*$suffix_re\$" || true))

    sed_args=(-E -e '/-dev$/d' -e '/-src$/d' -e '/-latest$/d')
    if [[ -z $PRERELEASE ]]; then
        sed_args+=(-e '/(a|b|rc)[0-9]+t?$/d' -e '/-(alpha|beta|rc)[0-9]*t?$/d')
    fi
    if [[ -z $suffix ]]; then
        sed_args+=(-e '/([0-9]|-(alpha|beta|rc))t$/d')
    fi

    DEFINITION_CANDIDATES=(\
        $(printf '%s\n' "${DEFINITION_CANDIDATES[@]:-}" | \
          sed "${sed_args[@]}"
        ));

    # Compose a sorting key, followed by | and original value.
    # Normalize to 6 dot-separated base fields plus prerelease stage and number:
    # alpha/a=1, beta/b=2, rc=3, final=4.
    DEFINITION_CANDIDATES=(\
        $(printf '%s\n' "${DEFINITION_CANDIDATES[@]:-}" | \
          awk \
            '{
               if ($0 == "") next;
               orig = $0;
               s = $0;
               if (match(s, /([0-9]|-(alpha|beta|rc))t$/)) {
                 s = substr(s, 1, length(s) - 1);
               }
               stage = 4;
               pre_num = 0;
               if (match(s, /-(alpha|beta|rc)[0-9]*$/)) {
                 pre = substr(s, RSTART + 1, RLENGTH - 1);
                 s = substr(s, 1, RSTART - 1);
                 if (pre ~ /^alpha/) { stage = 1; pre_num = (length(pre) > 5 ? substr(pre, 6) + 0 : 0); }
                 else if (pre ~ /^beta/) { stage = 2; pre_num = (length(pre) > 4 ? substr(pre, 5) + 0 : 0); }
                 else { stage = 3; pre_num = (length(pre) > 2 ? substr(pre, 3) + 0 : 0); }
               } else if (match(s, /([0-9]|-)(a|b|rc)[0-9]+$/)) {
                 pre = substr(s, RSTART + 1, RLENGTH - 1);
                 if (substr(s, RSTART, 1) == "-") {
                   s = substr(s, 1, RSTART - 1);
                 } else {
                   s = substr(s, 1, RSTART);
                 }
                 if (pre ~ /^a/) { stage = 1; pre_num = substr(pre, 2) + 0; }
                 else if (pre ~ /^b/) { stage = 2; pre_num = substr(pre, 2) + 0; }
                 else { stage = 3; pre_num = substr(pre, 3) + 0; }
               }
               if (match(s, /^[[:alnum:].]+-/)) {
                 s = substr(s, 1, RLENGTH - 1) "." (RLENGTH < length(s) ? substr(s, RLENGTH + 1) : "");
               }
               n = split(s, parts, ".");
               out = parts[1];
               for (i = 2; i <= 6; i++) {
                 out = out "." (i <= n ? parts[i] : "0");
               }
               print out "." stage "." pre_num ".|" orig;
             }'))
    DEFINITION_CANDIDATES=(\
        $(printf '%s\n' "${DEFINITION_CANDIDATES[@]:-}" \
          | sort -t. -k1,1r -k 2,2nr -k 3,3nr -k4,4nr -k5,5nr -k6,6nr -k7,7nr -k8,8nr \
          | cut -f2 -d $'|' \
        || true))
    DEFINITION="${DEFINITION_CANDIDATES[0]:-}"

    if [[ -n $DEFINITION ]]; then
        echo "$DEFINITION"
    else
        if [[ -z $BYPASS ]]; then
            echo "pyenv: no $([[ -z $FROM_KNOWN ]] && echo installed || echo known) versions match the prefix \`$prefix$suffix'" >&2
        else
            echo "$prefix$suffix"
        fi
        if [[ -z $FORCE ]]; then
            exitcode=1
        fi
    fi

exit $exitcode
