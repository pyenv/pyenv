#!/usr/bin/env bash
# Summary: Print the latest installed or known version with the given prefix
# Usage: pyenv latest [-k|--known] <prefix>
#
#   -k/--known      Select from all known versions instead of installed
#   -b/--bypass     (internal) On a resolution failure, do not print an error message
#                   but rather print the argument unchanged
#   -f/--force      (internal) Same as -b but also do not return a failure exit code

set -euo pipefail
set -f
[ -n "${PYENV_DEBUG:-}" ] && set -x

FROM_KNOWN=
BYPASS=
FORCE=

while [[ $# -gt 0 ]]
do
    case "$1" in
        -k|--known)
            FROM_KNOWN=1
            shift
            ;;
        -b|--bypass)
            BYPASS=1
            shift
            ;;
        -f|--force)
            FORCE=1
            BYPASS=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

prefix="${1:-}"
exitcode=0

IFS=$'\n'

    if [[ -z "$FROM_KNOWN" ]]; then
        if [[ -d $PYENV_ROOT/versions/$prefix ]]; then
            echo "$prefix"
            exit $exitcode;
        fi
        DEFINITION_CANDIDATES=( $(pyenv-versions --bare --skip-envs) )
    else
        DEFINITION_CANDIDATES=( $(pyenv-install --list --bare) )
    fi

    suffix=
    if [[ $prefix =~ ^(.*[0-9])t$ ]]; then
        suffix="t"
        prefix="${BASH_REMATCH[1]}"
    fi

    # Filtered in Bash since this runs on every shim call if a prefix is selected
    prerelease_re='(a|b|rc)[0-9]+t?$'
    matches=()
    # Bash < 4.4 treats empty arrays as unset with -u
    for candidate in "${DEFINITION_CANDIDATES[@]:-}"; do
        if [[ $candidate == "$prefix$suffix" ]]; then
            echo "$candidate"
            exit $exitcode;
        fi
        [[ $candidate == "$prefix"[-.]*"$suffix" ]] || continue
        [[ $candidate == *-dev || $candidate == *-src || $candidate == *-latest ]] && continue
        [[ $candidate =~ $prerelease_re ]] && continue
        [[ -z $suffix && $candidate == *[0-9]t ]] && continue
        matches+=("$candidate")
    done

    if [[ ${#matches[@]} -gt 1 ]]; then
        # Compose a sorting key, followed by | and original value
        matches=(\
            $(printf '%s\n' "${matches[@]}" \
              | awk \
                '{ if (match($0,"^[[:alnum:].]+-"))
                   { print substr($0,0,RLENGTH-1) "." substr($0,RLENGTH+1) "..|" $0; }
                 else
                   { print $0 "...|" $0; }
                 }' \
              | sort -t. -k1,1r -k 2,2nr -k 3,3nr -k4,4nr -k5,5nr -k6,6nr \
              | cut -f2 -d $'|' \
            || true))
    fi
    DEFINITION="${matches[0]:-}"

    if [[ -n $DEFINITION ]]; then
        echo "$DEFINITION"
    else
        if [[ -z $BYPASS ]]; then
            echo "pyenv: no $([[ -z $FROM_KNOWN ]] && echo installed || echo known) versions match the prefix \`$prefix$suffix'" >&2
        else
            echo "$prefix$suffix"
        fi
        if [[ -z $FORCE ]]; then
            exitcode=1
        fi
    fi

exit $exitcode
