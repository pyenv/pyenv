VERSION='7.3.21'
PYVER='2.7'

sha=d3b512ec2c511e8d8afe9e030cf013a853ce0bfe

### end of manual settings - following lines same for every download

require_openssl3
PYTHON_BUILD_HOMEBREW_TCLTK_FORMULA="${PYTHON_BUILD_HOMEBREW_TCLTK_FORMULA:-tcl-tk tcl-tk@8}"
install_git "pypy${PYVER}-v${VERSION}-src" https://github.com/pypy/pypy "release-pypy${PYVER}-v${VERSION}:$sha" pypy_builder "verify_py${PYVER//./}" 'ensurepip_lt21'
