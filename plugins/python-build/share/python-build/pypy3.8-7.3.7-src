VERSION='7.3.7'
PYVER='3.8'

prefer_openssl11
install_package "openssl-1.1.1f" "https://www.openssl.org/source/openssl-1.1.1f.tar.gz#186c6bfe6ecfba7a5b48c47f8a1673d0f3b0e5ba2e25602dd23b629975da3f35" mac_openssl --if has_broken_mac_openssl
install_git "pypy${PYVER}-v${VERSION}-src" https://github.com/pypy/pypy "release-pypy${PYVER}-v${VERSION}":8a2bea7e8212294d46aef80ba4eeb26735ec836c "pypy_builder" "verify_py${PYVER//./}" ensurepip
