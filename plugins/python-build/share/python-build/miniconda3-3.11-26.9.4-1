export CONDA_PLUGINS_AUTO_ACCEPT_TOS=true
case "$(anaconda_architecture 2>/dev/null || true)" in
"Linux-aarch64" )
  install_script "Miniconda3-py311_26.9.4-1-Linux-aarch64" "https://repo.anaconda.com/miniconda/Miniconda3-py311_26.9.4-1-Linux-aarch64.sh#c1c67b260ec075914b63f84dcff0b0b7e98bb69a016c14b7139131120b348210" "miniconda" verify_py311
  ;;
"Linux-x86_64" )
  install_script "Miniconda3-py311_26.9.4-1-Linux-x86_64" "https://repo.anaconda.com/miniconda/Miniconda3-py311_26.9.4-1-Linux-x86_64.sh#6dcf907532813e1007605cbcbd3012becb348de2657f9faaf03494b864faa240" "miniconda" verify_py311
  ;;
"MacOSX-arm64" )
  install_script "Miniconda3-py311_26.9.4-1-MacOSX-arm64" "https://repo.anaconda.com/miniconda/Miniconda3-py311_26.9.4-1-MacOSX-arm64.sh#3e2c0e0ab66d9ee3bcd7e0d83089001e072a47cd66732d146690ebade654ad45" "miniconda" verify_py311
  ;;
* )
  { echo
    colorize 1 "ERROR"
    echo ": The binary distribution of Miniconda is not available for $(anaconda_architecture 2>/dev/null || true)."
    echo
  } >&2
  exit 1
  ;;
esac
