prefer_openssl3
export PYTHON_BUILD_CONFIGURE_WITH_OPENSSL=1
export PYTHON_BUILD_CONFIGURE_WITH_OPENSSL_RPATH=1
prefer_tcltk_9
export PYTHON_BUILD_TCLTK_USE_PKGCONFIG=1
install_package "openssl-4.1.0" "https://github.com/openssl/openssl/releases/download/openssl-4.1.0/openssl-4.1.0.tar.gz#50c17baf54cb008f6ce42d50deb4b28050a1aad711636cabd4b241c7e90cc2fd" mac_openssl --if has_broken_mac_openssl
install_package "readline-8.3" "https://ftpmirror.gnu.org/readline/readline-8.3.tar.gz#fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc" mac_readline --if has_broken_mac_readline
if has_tar_xz_support; then
    install_package "Python-3.16.0a2" "https://www.python.org/ftp/python/3.16.0/Python-3.16.0a2.tar.xz#5fb6a0b8b7a70af2ee1386edcfb832e9636a5331b2bf0376a06cac33c43aa0d0" standard verify_py316 copy_python_gdb ensurepip
else
    install_package "Python-3.16.0a2" "https://www.python.org/ftp/python/3.16.0/Python-3.16.0a2.tgz#5a57709402e8ea35e7d95481ba35ce02bda5a57a4eb139d4a312987f6a6dff32" standard verify_py316 copy_python_gdb ensurepip
fi
