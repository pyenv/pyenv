if has_tar_xz_support; then
    install_package "Python-3.14.9" "https://www.python.org/ftp/python/3.14.9/Python-3.14.9.tar.xz#e02d9ac21cebda6e46435369744a92c65cc7cd8669697694122cf97ffacd1e53" standard verify_py314 copy_python_gdb ensurepip
else
    install_package "Python-3.14.9" "https://www.python.org/ftp/python/3.14.9/Python-3.14.9.tgz#8b47e85ee67e93945e93620a051a8f44bfc1e9735ed67075d166f4a74b7a060b" standard verify_py314 copy_python_gdb ensurepip
fi
