#!/usr/bin/env bash
set -euo pipefail
hash_mode=
aria2c=
wget=
src=
dest=
dir_=

case "$1" in
  hash)
    hash_mode=1; shift;;
  aria2c)
    aria2c=1; shift;;
  wget)
    wget=1; shift;;
esac
while (($#)); do
  case "$1" in
    -o)
      if [[ -z $wget ]]; then
        dest="$2"
        shift
      fi
      ;;
    -O)
      if [[ -n $wget ]]; then
        dest="$2"
        shift
      fi
      ;;
    -d)
      if [[ -n $aria2c ]]; then
        dir_="$2/"
        shift
      fi
      ;;
    -*)
      ;;
    *)
      src="$FIXTURE_ROOT/${1##*/}"
      ;;
  esac
  shift
done
[[ -n $hash_mode ]] && src="${src%/*}/$dest"
cp "$src" "${dir_}${dest}"
