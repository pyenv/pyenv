#!/usr/bin/env bash
#
# Summary: Find a matching published binary package
#
# Usage: pyenv binary find <definition>
#
#   Prints the definition name, package entry and definition checksum, separated
#   by tabs. Takes an exact name; does not resolve, download or install it.
#
set -e
[ -n "$PYENV_DEBUG" ] && set -x

if [ "$1" = "--complete" ]; then
  exit
fi

if [ "$#" -ne 1 ]; then
  pyenv-help --usage binary-find >&2
  exit 1
fi

version="$1"
source "${BASH_SOURCE%/*}/../share/pyenv-binary/common.bash"
if ! is_name_safe "$version" || [[ "$version" = *[!A-Za-z0-9._-]* ]]; then
  echo "pyenv-binary: invalid version name \`$version'" >&2
  exit 1
fi

source "${BASH_SOURCE%/*}/../share/pyenv-binary/platform.bash"
target=""
case "$os" in
Linux | Darwin )
  target="$(package_suffix "$os" "$distro" "$arch" 2>/dev/null)" || target=""
  ;;
esac

record_file="${BASH_SOURCE%/*}/../share/pyenv-binary/versions/$version"
entry=""
if [ -f "$record_file" ]; then
  while IFS= read -r record || [ -n "$record" ]; do
    IFS=$'\t' read -r suffix sha256 _ <<<"$record"
    # Keep empty checksums for local overrides, but require exactly two fields.
    if [ "$record" != "$suffix"$'\t'"$sha256" ] ||
       ! is_name_safe "$suffix" || [[ "$suffix" = *[!A-Za-z0-9._-]* ]]; then
      echo "pyenv-binary: invalid binary record for $version" >&2
      exit 1
    fi
    [ "$suffix" = "$target" ] || continue
    if [ -n "$entry" ]; then
      echo "pyenv-binary: multiple binaries available for $version on $os/$arch" >&2
      exit 1
    fi
    entry="$version-$suffix"
    expected_sha="$sha256"
  done < "$record_file"
fi

if [ -z "$entry" ]; then
  echo "pyenv-binary: no binary available for $version on $os/$arch" >&2
  exit 1
fi

printf '%s\t%s\t%s\n' "$version" "$entry" "$expected_sha"
