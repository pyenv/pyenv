#!/usr/bin/env bash
#
# Summary: Install a published binary package
#
# Usage: pyenv binary install <version>
#
#   Selects a matching published package from pyenv.github.io and installs it
#   under <version>. Ordinary `pyenv install' is unchanged.
#
set -e
[ -n "$PYENV_DEBUG" ] && set -x

if [ "$1" = "--complete" ]; then
  exit
fi

if [ "$#" -ne 1 ]; then
  pyenv-help --usage binary-install >&2
  exit 1
fi

source "${BASH_SOURCE%/*}/../share/pyenv-binary/common.bash"
if ! is_name_safe "$1"; then
  echo "pyenv-binary: invalid version name \`$1'" >&2
  exit 1
fi

version="$(pyenv-latest -f -k "$1")"
selection="$(pyenv-binary-find "$version")"
IFS=$'\t' read -r version entry expected_sha <<< "$selection"

definitions="$(pyenv-install --list --bare)"
if grep -qxF -- "$entry" <<<"$definitions"; then
  pyenv-install "$entry:$version"
  exit
fi

expected_sha="$(printf '%s' "$expected_sha" | tr '[:upper:]' '[:lower:]')"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
base_url="https://pyenv.github.io/pythons/binaries"

curl -fsSL -o "$tmpdir/$entry" "$base_url/$entry"
if command -v sha256sum >/dev/null 2>&1; then
  actual_sha="$(sha256sum "$tmpdir/$entry")"; actual_sha="${actual_sha%% *}"
elif command -v shasum >/dev/null 2>&1; then
  actual_sha="$(shasum -a 256 "$tmpdir/$entry")"; actual_sha="${actual_sha%% *}"
elif command -v openssl >/dev/null 2>&1; then
  actual_sha="$(openssl dgst -sha256 "$tmpdir/$entry")"; actual_sha="${actual_sha##* }"
else
  echo "pyenv-binary: need sha256sum, shasum or openssl to verify $entry" >&2
  exit 1
fi
if [[ $expected_sha != "$actual_sha"  ]]; then
  echo "pyenv-binary: checksum mismatch for $entry" >&2
  exit 1
fi
pyenv-install "$tmpdir/$entry:$version"
